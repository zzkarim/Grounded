# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# The Anthropic SDK also works without this if you've run `ant auth login`.
ANTHROPIC_API_KEY=

# The ONE place the experiment's model is configured. All systems use it.
# Every run file records both this value and the model id the API reports.
GROUNDED_MODEL=claude-sonnet-5-5

# Reasoning effort for every call (low | medium | high). Fixed per experiment; recorded per run.
GROUNDED_EFFORT=medium
